rules_version = '2';

// VDI TimeKeeper security rules.
// 1) In the isManager line below, replace the placeholder with your user ID
//    (the app shows it to you after you sign up). Keep the single quotes.
// 2) In Firebase: Firestore Database > Rules. Delete everything there, paste this whole file,
//    and click Publish.
//
// What these rules guarantee:
//  - Only the manager can read anyone's punches or hours.
//  - An employee can read and edit only their own time card (name, reminders, on/off clock).
//  - An employee can never read punches, even their own, and can never edit or delete one.
//  - Clock-in and clock-out times are stamped by Google's servers, not the phone.
//  - Each shift can be recorded only once, so hours can't be padded.

service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null && request.auth.uid == 'PASTE_YOUR_UID';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function cardBefore(uid) {
      return get(/databases/$(database)/documents/staff/$(uid)).data;
    }
    function cardAfter(uid) {
      return getAfter(/databases/$(database)/documents/staff/$(uid)).data;
    }

    match /staff/{uid} {
      allow read, write: if isManager();

      allow read: if isSelf(uid);

      // First-time setup of an employee's own time card.
      allow create: if isSelf(uid)
        && request.resource.data.onClock == false
        && request.resource.data.since == null;

      allow update: if isSelf(uid) && (
        // Clock in: start time must be the server's time.
        (request.resource.data.onClock == true && resource.data.onClock == false
          && request.resource.data.since == request.time)
        // Clock out.
        || (request.resource.data.onClock == false && request.resource.data.since == null)
        // Name or reminder change: clock state untouched.
        || (request.resource.data.onClock == resource.data.onClock
          && request.resource.data.since == resource.data.since)
      );

      match /punches/{punchId} {
        allow read, write: if isManager();

        // An employee may add only the one punch that closes their current shift:
        // named after the clock-in time, stamped with the server's clock-out time,
        // and saved together with clocking out.
        allow create: if isSelf(uid)
          && cardBefore(uid).onClock == true
          && cardBefore(uid).since != null
          && punchId == string(cardBefore(uid).since.toMillis())
          && cardAfter(uid).onClock == false
          && request.resource.data.keys().hasOnly(['in', 'out', 'week'])
          && request.resource.data.in == cardBefore(uid).since
          && request.resource.data.out == request.time
          && request.resource.data.week is string;
      }
    }
  }
}
